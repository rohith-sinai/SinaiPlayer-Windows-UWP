<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SinaiPlayer.Lib.UI.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Pages"
    xmlns:lists="using:SinaiPlayer.Lib.UI.Lists"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LargeTitle" FontSize="40" Style="{ThemeResource TitleTextBlockStyle}" Margin="30,50,0,0"/>

        <StackPanel Grid.Row="1" x:Name="EmptyView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
 
            <TextBlock x:Name="EmptyView_Title" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock x:Name="EmptyView_SubTitle" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>

            <Button x:Name="NewPlaylistFromEmptyViewButton" Click="NewPlaylist_Button_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="ContentView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="45" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="30,0,0,0">
                <!--New Playlist Button-->
                <Button x:Name="NewPlaylist_Button" Click="NewPlaylist_Button_Click" Background="Transparent" BorderThickness="0" Padding="0"  Style="{StaticResource TextBlockButtonStyle}" Foreground="{ThemeResource TextBoxForegroundHeaderThemeBrush}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NewPlaylistTextBlock" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!--Sort-->
                <TextBlock x:Name="SortByTextBlock" VerticalAlignment="Center" Margin="30,0,0,1" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!--Sort Option ComboBox-->
                <ComboBox x:Name="SortComboBox" SelectionChanged="SortComboBox_SelectionChanged" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Height="24" Padding="0" Margin="8,0,0,0" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" FontSize="14"  />

            </StackPanel>

            <Grid Grid.Row="1">
                <lists:PlaylistsRegularGridView x:Name="RegularGridView" ItemClickEvent="GridView_ItemClickEvent"/>
                <lists:PlaylistsGroupedGridView x:Name="GroupedGridView" ItemClickEvent="GridView_ItemClickEvent"/>
            </Grid>
        </Grid>
        
    </Grid>
</Page>

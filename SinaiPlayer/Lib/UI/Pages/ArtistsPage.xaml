<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SinaiPlayer.Lib.UI.Pages.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Pages"
    xmlns:adapters="using:SinaiPlayer.Lib.UI.Adapters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">
    
    <Page.Resources>
        <!-- Removes the bottom border/divider line color on the group headers -->
        <SolidColorBrush x:Key="GridViewHeaderItemDividerStroke" Color="Transparent" />
        <!-- Optional: Ensures border thickness variables don't force layout spacing -->
        <Thickness x:Key="GridViewHeaderItemBorderThickness">0</Thickness>
    </Page.Resources>
    
    <Grid>
        <SemanticZoom x:Name="GroupedView">
            <SemanticZoom.ZoomedInView> 
                <GridView x:Name="GridViewContainer" Padding="20,0,20,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GridView_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <adapters:ArtistGridAdapter/>
                        </DataTemplate>
                    </GridView.ItemTemplate>

                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key}" FontSize="18" FontWeight="Medium" Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </GridView.GroupStyle>
                    
                    <GridView.FooterTemplate>
                        <DataTemplate>
                            <Grid Height="85" />
                        </DataTemplate>
                    </GridView.FooterTemplate>
                </GridView>
            </SemanticZoom.ZoomedInView>
            
            <SemanticZoom.ZoomedOutView>
                <ListView x:Name="ZoomedOutListView">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Group.Key}" FontSize="18" Margin="8"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>
    </Grid>
    
</Page>

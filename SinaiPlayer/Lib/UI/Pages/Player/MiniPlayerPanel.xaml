<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SinaiPlayer.Lib.UI.Pages.Player.MiniPlayerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Pages.Player" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="{Binding MiniPlayerHeight}">

    <Grid Background="{ThemeResource AcrylicInAppFillColorBaseBrush}" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">

        <Border Background="Transparent" Opacity="0.2" BorderBrush="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}" BorderThickness="1" Height="1" VerticalAlignment="Top"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding GridColumnDefination2Width}"/>
                <ColumnDefinition Width="{Binding GridColumnDefination3Width}"/>
            </Grid.ColumnDefinitions>

            <!--Titles and cover art-->

            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Click="ContentButton_Click">
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <!-- Overrides the Light/Dark Theme Hover state to keep colors static -->
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black" Opacity="0.7"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black" Opacity="0.5"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" Opacity="0.7"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" Opacity="0.5"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Button.Resources>

                <StackPanel  Orientation="Horizontal" VerticalAlignment="Center"
     Margin="0,0,20,0">

                    <Grid Height="{Binding ArtworkHeight}" Width="{Binding ArtworkWidth}" CornerRadius="8">
                        <Rectangle Fill="{ThemeResource SolidBackgroundFillColorBaseAltBrush}" />
                        <FontIcon Glyph="&#xE958;" FontSize="{Binding ArtworkPlacholderFontSize}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{ThemeResource ControlSolidFillColorDefaultBrush}"/>
                        <Image Source="{Binding Image}" Stretch="Fill" />
                        <Grid x:Name="HoverContainer" Opacity="0">
                            <Rectangle Fill="Black" Opacity="0.4" />
                            <FontIcon Glyph="&#xE70E;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" />
                        </Grid>
                        <Border Background="Transparent" Opacity="0.2" BorderBrush="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="8"/>

                    </Grid>

                    <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="{Binding TitleFontSize}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SubTitle}" FontSize="{Binding SubTitleFontSize}" Visibility="{Binding SubTitleVisibility}" Opacity="0.8"/>
                    </StackPanel>

                </StackPanel>

            </Button>

            <!-- Desktop Controls-->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding DesktopControlsVisiblility}">
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <!--Shuffle Button-->
                    <Button Click="Shuffle_Button_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="0,0,20,0" Background="Transparent" BorderThickness="0">
                        <Grid>
                            <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Opacity="{Binding ShuffleIconOpacity}"/>
                            <Line X1="0" Y1="0" X2="18" Y2="18" Stroke="{ThemeResource SystemBaseHighColor}" StrokeThickness="1" Opacity="{Binding ShuffleDisabledLineOpacity}"/>
                        </Grid>
                    </Button>
                    <!--Previous Button-->
                    <Button Click="Previous_Button_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="0,0,12,0" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xEB9E;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </Button>
                    <!--Play/Pause Button-->
                    <Button Click="PlayPause_Button_Click" Height="40" Width="40" CornerRadius="20" Padding="0" >
                        <FontIcon Glyph="{Binding PlayPauseIcon}" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </Button>
                    <!--Next Button-->
                    <Button Click="Next_Button_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="12,0,0,0" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xEB9D;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    </Button>
                    <!--Repeat Button-->
                    <Button Click="Repeat_Button_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="20,0,0,0" Background="Transparent" BorderThickness="0">
                        <Grid>
                            <FontIcon x:Name="Repeat_Icon" Glyph="{Binding RepeatIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Opacity="{Binding RepeatIconOpacity}" />
                            <Line X1="0" Y1="0" X2="18" Y2="18" Stroke="{ThemeResource SystemBaseHighColor}" StrokeThickness="1" Opacity="{Binding RepeatDisabledLineOpacity}"/>
                        </Grid>
                    </Button>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="45" />
                    </Grid.ColumnDefinitions>
                    <!--Elapsed Time-->
                    <TextBlock x:Name="ElapsedTime" Grid.Column="0" FontSize="12" VerticalAlignment="Center" Opacity="0.7"/>
                    <Grid Grid.Column="1">
                        <!--Seek Bar-->
                        <Slider x:Name="SeekBar" Opacity="{Binding SeekBarOpacity}" ValueChanged="SeekBar_ValueChanged" IsThumbToolTipEnabled="False"/>
                        <!--Progress Bar-->
                        <muxc:ProgressBar Visibility="{Binding ProgressBarVisibility}" IsIndeterminate="True" ShowPaused="False" ShowError="False" />
                    </Grid>
                    <!--Total Time-->
                    <TextBlock x:Name="TotalTime" Grid.Column="2" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
                </Grid>
            </StackPanel>

            <!--Volume and more options-->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding DesktopControlsVisiblility}" Margin="0,12,20,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <!--Toggle Mute Button-->
                <Button Click="ToggleMute_Button_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="20,0,0,0" Background="Transparent" BorderThickness="0">
                    <Grid>
                        <FontIcon Glyph="{Binding VolumeIcon}" FontSize="17" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <FontIcon Glyph="&#xEBC5;" FontSize="17" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Opacity="0.3" Visibility="{Binding VolumeHintBarVisibility}" />
                    </Grid>
                </Button>
                <!--Volume Slider-->
                <Slider x:Name="VolumeSlider" ValueChanged="Volume_Slider_ValueChanged" Minimum="0" Maximum="100" Width="100" Margin="6,0,6,0" />
                <!--Full Screen Button-->
                <Button x:Name="FullScreenButton" Click="ToggleFullScreen_Button_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="8,0,0,0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE740;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <!--More Options Button-->
                <Button Height="32" Width="32" CornerRadius="16" Padding="0" Margin="8,0,0,0" Background="Transparent" BorderThickness="0">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="AddToPlaylistMenuFlyoutItem" Click="AddToPlaylist_MenuFlyoutItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xECC8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveQueueMenuFlyoutItem" Click="SaveQueue_MenuFlyoutItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="InfoMenuFlyoutItem" Click="Info_MenuFlyoutItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="PlaybackSpeedMenuFlyoutItem">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xEC4A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="0.25x" Click="PlaybackSpeed0Point25xFlyoutItem_Click"/>
                                <MenuFlyoutItem Text="0.5x" Click="PlaybackSpeed0Point5xFlyoutItem_Click"/>
                                <MenuFlyoutItem Text="1.0x" Click="PlaybackSpeed1PointOxFlyoutItem_Click"/>
                                <MenuFlyoutItem Text="1.25x" Click="PlaybackSpeed1Point25xFlyoutItem_Click"/>
                                <MenuFlyoutItem Text="1.5x" Click="PlaybackSpeed1Point5xFlyoutItem_Click"/>
                                <MenuFlyoutItem Text="2.0x" Click="PlaybackSpeed2PointOxFlyoutItem_Click"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="StopMenuFlyoutItem" Click="Stop_MenuFlyoutItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE712;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>

            <!--Mobile Controls-->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2" Visibility="{Binding MobileControlsVisiblility}">
                <!--Previous Button-->
                <Button Click="Previous_Button_Click" IsEnabled="{Binding IsPreviousButtonVisible}" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="0,0,12,0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xEB9E;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <!--Play/Pause Button-->
                <Button Click="PlayPause_Button_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="0,0,12,0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="{Binding PlayPauseIcon}" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <!--Next Button-->
                <Button  Click="Next_Button_Click" IsEnabled="{Binding IsNextButtonVisible}" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="0,0,30,0" Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xEB9D;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

    </Grid>

</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SinaiPlayer.Lib.UI.Pages.Player.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Pages.Player"
    xmlns:adapters="using:SinaiPlayer.Lib.UI.Adapters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <Border Background="Transparent" Opacity="0.2" BorderBrush="White" BorderThickness="1" Height="1" VerticalAlignment="Bottom" Margin="32,0,32,0"/>

            <StackPanel  Orientation="Horizontal" Margin="40,0,40,12" VerticalAlignment="Center">
                <TextBlock x:Name="QueueListHeaderTextBlock" FontWeight="SemiBold" FontSize="17"  VerticalAlignment="Center"/>
                <Button Click="ShuffleButton_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="20,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                    <Grid>
                        <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Opacity="0.5"/>
                        <Line x:Name="ShuffleDisabledLine" X1="0" Y1="0" X2="18" Y2="18" Stroke="{ThemeResource SystemBaseHighColor}" StrokeThickness="1" Opacity="0.5"/>
                    </Grid>
                </Button>
                <Button Click="RepeatButton_Click" Height="32" Width="32" CornerRadius="16" Padding="0" Margin="20,0,0,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                    <Grid>
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Opacity="0.5" />
                        <Line x:Name="RepeatDisabledLine"  X1="0" Y1="0" X2="18" Y2="18" Stroke="{ThemeResource SystemBaseHighColor}" StrokeThickness="1" Opacity="0.5"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <ListView x:Name="QueueListView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="QueueListView_ItemClick" Padding="20,0,20,0">

            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <ContentThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>

            <ListView.Resources>
                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
            </ListView.Resources>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <adapters:QueueAdapter />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

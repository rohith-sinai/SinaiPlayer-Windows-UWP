<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SinaiPlayer.Lib.UI.Adapters.PlaylistSongAdapter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Adapters"
    xmlns:vm="using:SinaiPlayer.Lib.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="Item_PointerEntered" 
    PointerExited="Item_PointerExited">


    <Grid Height="56" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" DoubleTapped="Item_DoubleTapped" IsDoubleTapEnabled="True">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="NormalState">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverContainer" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="HoverState">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverContainer" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="{x:Bind ((vm:PlaylistItemViewModel)DataContext).GridColumnDefination2Width, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind ((vm:PlaylistItemViewModel)DataContext).GridColumnDefination3Width, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind ((vm:PlaylistItemViewModel)DataContext).GridColumnDefination4Width, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind ((vm:PlaylistItemViewModel)DataContext).GridColumnDefination5Width, Mode=OneWay}" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0" Margin="6,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{Binding CombinedTitleVisibility}">
            <TextBlock Text="{Binding Title}" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <TextBlock Text="{Binding SubTitle}" Opacity="0.7" FontSize="13.7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </StackPanel>

        <Grid Grid.Column="0" Visibility="{Binding TitleVisibility}" Margin="6,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14"  HorizontalAlignment="Stretch"  VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="1"/>

            <StackPanel x:Name="HoverContainer" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                <Button Click="Play_HoverButton_Click" Height="30" Width="30" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="15" Margin="12,0,8,0">
                    <FontIcon Glyph="&#xE768;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Click="RemoveFromPlaylist_HoverButton_Click" Height="30" Width="30" CornerRadius="15" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0">
                    <FontIcon Glyph="&#xECC9;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
            
        </Grid>


        <!--Artist-->
        <TextBlock Grid.Column="1" x:Name="SongArtist" Text="{x:Bind ((vm:PlaylistItemViewModel)DataContext).Artist, Mode=OneWay}" Opacity="0.7" Visibility="{x:Bind ((vm:PlaylistItemViewModel)DataContext).ArtistVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <!--Album-->
        <TextBlock Grid.Column="2" x:Name="SongAlbum" Text="{x:Bind ((vm:PlaylistItemViewModel)DataContext).Album, Mode=OneWay}" Opacity="0.7" Visibility="{x:Bind ((vm:PlaylistItemViewModel)DataContext).AlbumVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <!--Year-->
        <TextBlock Grid.Column="3" x:Name="SongYear" Text="{x:Bind ((vm:PlaylistItemViewModel)DataContext).Year, Mode=OneWay}" Opacity="0.7" Visibility="{x:Bind ((vm:PlaylistItemViewModel)DataContext).YearVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch"  VerticalAlignment="Center"/>

        <!--Genre-->
        <TextBlock Grid.Column="4" x:Name="SongGenre" Text="{x:Bind ((vm:PlaylistItemViewModel)DataContext).Genre, Mode=OneWay}" Opacity="0.7"  Visibility="{x:Bind ((vm:PlaylistItemViewModel)DataContext).GenreVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,30,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <!--Duration-->
        <TextBlock Grid.Column="5" x:Name="SongDuration" Text="{x:Bind ((vm:PlaylistItemViewModel)DataContext).Duration, Mode=OneWay}" Opacity="0.7" FontSize="12" Margin="30,0,0,0" HorizontalAlignment="Stretch"  VerticalAlignment="Center"/>

    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SinaiPlayer.Lib.UI.Adapters.QueueAdapter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Adapters"
    xmlns:vm="using:SinaiPlayer.Lib.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="0,8,0,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="PlayNowMenuFlyoutItem" Click="PlayNow_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="AddToPlaylistMenuFlyoutItem" Click="AddToPlaylist_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RemoveMenuFlyoutItem" Click="Remove_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xECC9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="{x:Bind ((vm:QueueViewModel)DataContext).GridColumnDefination2Width, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind ((vm:QueueViewModel)DataContext).GridColumnDefination3Width, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind ((vm:QueueViewModel)DataContext).GridColumnDefination4Width, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind ((vm:QueueViewModel)DataContext).GridColumnDefination5Width, Mode=OneWay}" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0" Margin="0,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{x:Bind ((vm:QueueViewModel)DataContext).CombinedTitleVisibility, Mode=OneWay}">
            <TextBlock x:Name="SongTitle" Text="{x:Bind ((vm:QueueViewModel)DataContext).Title, Mode=OneWay}" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="White" />
            <TextBlock x:Name="SongArtistAndAlbum" Text="{x:Bind ((vm:QueueViewModel)DataContext).SubTitle, Mode=OneWay}" Opacity="0.7" FontSize="13.7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="White"/>
        </StackPanel>

        <TextBlock Grid.Column="0"  Margin="6,8,0,8" Text="{x:Bind ((vm:QueueViewModel)DataContext).Title, Mode=OneWay}" FontSize="14" Visibility="{x:Bind ((vm:QueueViewModel)DataContext).TitleVisibility, Mode=OneWay}" HorizontalAlignment="Stretch"  VerticalAlignment="Center"  Foreground="White"/>

        <!--Artist-->
        <TextBlock Grid.Column="1" x:Name="SongArtist" Text="{x:Bind ((vm:QueueViewModel)DataContext).Artist, Mode=OneWay}" Opacity="0.7" Visibility="{x:Bind ((vm:QueueViewModel)DataContext).ArtistVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="White"/>

        <!--Album-->
        <TextBlock Grid.Column="2" x:Name="SongAlbum" Text="{x:Bind ((vm:QueueViewModel)DataContext).Album, Mode=OneWay}" Opacity="0.7" Visibility="{x:Bind ((vm:QueueViewModel)DataContext).AlbumVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="White"/>

        <!--Year-->
        <TextBlock Grid.Column="3" x:Name="SongYear" Text="{x:Bind ((vm:QueueViewModel)DataContext).Year, Mode=OneWay}" Opacity="0.7" Visibility="{x:Bind ((vm:QueueViewModel)DataContext).YearVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch"  VerticalAlignment="Center" Foreground="White"/>

        <!--Genre-->
        <TextBlock Grid.Column="4" x:Name="SongGenre" Text="{x:Bind ((vm:QueueViewModel)DataContext).Genre, Mode=OneWay}" Opacity="0.7"  Visibility="{x:Bind ((vm:QueueViewModel)DataContext).GenreVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,30,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="White"/>

        <!--Duration-->
        <TextBlock Grid.Column="5" x:Name="SongDuration" Text="{x:Bind ((vm:QueueViewModel)DataContext).Duration, Mode=OneWay}" Opacity="0.7" FontSize="12" Margin="30,0,0,0" HorizontalAlignment="Stretch"  VerticalAlignment="Center" Foreground="White"/>

    </Grid>
    
</UserControl>

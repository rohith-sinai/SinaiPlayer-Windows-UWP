<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SinaiPlayer.Lib.UI.Adapters.NowPlayingPagerAdapter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Adapters"
    xmlns:vm="using:SinaiPlayer.Lib.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <RelativePanel>

        <RelativePanel.Resources>
            <!-- Same Fluent decelerate/accelerate ease curve as PlayerBackgroundContainer/
                 PlayerControls, so the titles fade feels like one coordinated motion system
                 with the rest of the inactivity animation. Only ever begun for video, since
                 for audio there's no video underneath for the titles to be hiding. -->
            <!-- BeginTime holds at full opacity for a beat after the background dim and
                 transport controls have already started fading, so the titles are the last
                 thing to disappear rather than all three fading in lockstep. -->
            <Storyboard x:Name="FadeOutStoryboard" Completed="FadeOutStoryboard_Completed" BeginTime="0:0:1.5">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Titles_View" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0.0" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Name="FadeInStoryboard">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Titles_View" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Shrinks the artwork/title/subtitle while NowPlayingPage's ExpandedView
                 (Queue/Lyrics) is open, so the pager row has more room; grows back when it
                 closes. Same ease curve as the fade, for the same coordinated feel. -->
            <Storyboard x:Name="ExpandedShrinkStoryboard">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentMediaImageView_Left_Viewbox" Storyboard.TargetProperty="Width">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="72" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentMediaImageView_Left_Viewbox" Storyboard.TargetProperty="Height">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="72" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentMedia_Title" Storyboard.TargetProperty="FontSize">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="20" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentMedia_SubTitle" Storyboard.TargetProperty="FontSize">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="14" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Name="ExpandedGrowStoryboard">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentMediaImageView_Left_Viewbox" Storyboard.TargetProperty="Width">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="120" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentMediaImageView_Left_Viewbox" Storyboard.TargetProperty="Height">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="120" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentMedia_Title" Storyboard.TargetProperty="FontSize">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="28" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentMedia_SubTitle" Storyboard.TargetProperty="FontSize">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="18" KeySpline="0.33,1,0.68,1"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </RelativePanel.Resources>

        <StackPanel x:Name="Titles_View" Orientation="Horizontal" Margin="30,0,30,0" RelativePanel.AlignBottomWithPanel="True" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignRightWithPanel="True">

            <!--
                The Viewbox scales this whole 120x120 artwork block down uniformly when
                NowPlayingPage's ExpandedView (Queue/Lyrics) is open, by animating its own
                Width/Height - the Grid inside keeps its natural 120x120 layout untouched.
            -->
            <Viewbox x:Name="CurrentMediaImageView_Left_Viewbox" Stretch="Uniform" Width="120" Height="120" Margin="0,0,16,0">
                <Grid x:Name="CurrentMediaImageView_Left" Height="120" Width="120" CornerRadius="8">
                    <Rectangle Fill="White" />
                    <FontIcon Glyph="&#xE91B;" FontSize="40" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="LightGray"/>
                    <Image Source="{x:Bind ((vm:QueueViewModel)DataContext).Image, Mode=OneWay}" Stretch="Fill"/>
                </Grid>
            </Viewbox>

            <Grid Height="120">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentMedia_Title" Text="{x:Bind ((vm:QueueViewModel)DataContext).Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" FontSize="28" Foreground="White" FontWeight="Bold" />
                    <TextBlock x:Name="CurrentMedia_SubTitle" Text="{x:Bind ((vm:QueueViewModel)DataContext).SubTitle, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="LightGray" FontSize="18" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

        </StackPanel>

    </RelativePanel>

</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Name="RootGrid"
    x:Class="SinaiPlayer.Lib.UI.Adapters.SongAdapter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Adapters"
    xmlns:vm="using:SinaiPlayer.Lib.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="Item_PointerEntered" 
    PointerExited="Item_PointerExited">


    <Grid Height="56" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" DoubleTapped="Item_DoubleTapped" IsDoubleTapEnabled="True">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HoverStates">
                <VisualState x:Name="NormalState">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverContainer" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Collapsed"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="HoverState">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverContainer" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutSubItem x:Name="PlayMenuFlyoutSubItem">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem x:Name="PlayNowMenuFlyoutItem" Click="PlayNow_FlyoutItem_Click"/>
                    <MenuFlyoutItem x:Name="PlayNextMenuFlyoutItem" Click="PlayNext_FlyoutItem_Click"/>
                    <MenuFlyoutItem x:Name="PlayLastMenuFlyoutItem" Click="PlayLast_FlyoutItem_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="AddToPlaylistMenuFlyoutItem" Click="AddToPlaylist_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ShowArtistMenuFlyoutItem" Click="ShowArtist_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="ShowAlbumMenuFlyoutItem" Click="ShowAlbum_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE93C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="EditMenuFlyoutItem" Click="Edit_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="InfoMenuFlyoutItem" Click="Properties_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="DeleteMenuFlyoutItem" Click="Delete_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!--Main Grid Column Definitions-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{x:Bind ((vm:SongViewModel)DataContext).GridColumnDefination2Width, Mode=OneWay}" />
            <ColumnDefinition x:Name="GridColumnDefinition3" Width="{Binding GridColumnDefination3String, ElementName=RootGrid}" />
            <ColumnDefinition Width="{x:Bind ((vm:SongViewModel)DataContext).GridColumnDefination4Width, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind ((vm:SongViewModel)DataContext).GridColumnDefination5Width, Mode=OneWay}" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TrackNumberTextBlock" Grid.Column="0" Text="{x:Bind ((vm:SongViewModel)DataContext).TrackNumber, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"  Visibility="Collapsed" />

        <!--Mobile Title Container-->
        <StackPanel Grid.Column="1" Margin="6,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="{x:Bind ((vm:SongViewModel)DataContext).CombinedTitleVisibility, Mode=OneWay}">
            <!--Title-->
            <TextBlock x:Name="TitleTextBlock" Text="{x:Bind ((vm:SongViewModel)DataContext).Title, Mode=OneWay}" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <!--SubTitle: Artist & Album-->
            <TextBlock Text="{x:Bind ((vm:SongViewModel)DataContext).SubTitle, Mode=OneWay}" Opacity="0.7" FontSize="13.7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </StackPanel>

        <!--Desktop Title Container-->
        <Grid Grid.Column="1" Visibility="{x:Bind ((vm:SongViewModel)DataContext).TitleVisibility, Mode=OneWay}" Margin="6,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--Title-->
            <TextBlock Grid.Column="0" Text="{x:Bind ((vm:SongViewModel)DataContext).Title, Mode=OneWay}" FontSize="14"  HorizontalAlignment="Stretch"  VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="1"/>

            <!--Hover Buttons-->
            <StackPanel x:Name="HoverContainer" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                <Button Click="Play_HoverButton_Click" Height="30" Width="30" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="15" Margin="12,0,8,0">
                    <FontIcon Glyph="&#xE768;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Click="AddToPlaylist_HoverButton_Click" Height="30" Width="30" CornerRadius="15" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0">
                    <FontIcon Glyph="&#xE710;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>

        </Grid>

        <!--Artist-->
        <TextBlock Grid.Column="2" x:Name="SongArtist" Text="{x:Bind ((vm:SongViewModel)DataContext).Artist, Mode=OneWay}" Opacity="0.7" Visibility="{x:Bind ((vm:SongViewModel)DataContext).ArtistVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <!--Album-->
        <TextBlock Grid.Column="3" x:Name="SongAlbum" Text="{x:Bind ((vm:SongViewModel)DataContext).Album, Mode=OneWay}" Opacity="0.7" Visibility="{Binding AlbumTextBlockVisibility, ElementName=RootGrid}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <!--Year-->
        <TextBlock Grid.Column="4" x:Name="SongYear" Text="{x:Bind ((vm:SongViewModel)DataContext).Year, Mode=OneWay}" Opacity="0.7" Visibility="{x:Bind ((vm:SongViewModel)DataContext).YearVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,0,0" HorizontalAlignment="Stretch"  VerticalAlignment="Center"/>

        <!--Genre-->
        <TextBlock Grid.Column="5" x:Name="SongGenre" Text="{x:Bind ((vm:SongViewModel)DataContext).Genre, Mode=OneWay}" Opacity="0.7"  Visibility="{x:Bind ((vm:SongViewModel)DataContext).GenreVisibility, Mode=OneWay}" FontSize="13.7" Margin="30,0,30,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <!--Duration-->
        <TextBlock Grid.Column="6" x:Name="SongDuration" Text="{x:Bind ((vm:SongViewModel)DataContext).Duration, Mode=OneWay}" Opacity="0.7" FontSize="12" Margin="30,0,0,0" HorizontalAlignment="Stretch"  VerticalAlignment="Center"/>

    </Grid>
</UserControl>

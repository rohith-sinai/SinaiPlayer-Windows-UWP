<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SinaiPlayer.Lib.UI.Adapters.PlaylistGridAdapter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinaiPlayer.Lib.UI.Adapters"
    xmlns:vm="using:SinaiPlayer.Lib.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <Grid.ContextFlyout>
            <MenuFlyout>

                <MenuFlyoutSubItem x:Name="PlayMenuFlyoutSubItem">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutSubItem.Icon>
                    <MenuFlyoutItem x:Name="PlayNowMenuFlyoutItem" Click="PlayNow_FlyoutItem_Click" />
                    <MenuFlyoutItem x:Name="PlayNextMenuFlyoutItem" Click="PlayNext_FlyoutItem_Click"/>
                    <MenuFlyoutItem x:Name="PlayLastMenuFlyoutItem" Click="PlayLast_FlyoutItem_Click"/>
                </MenuFlyoutSubItem>

                <MenuFlyoutItem x:Name="EditMenuFlyoutItem" Click="Edit_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <MenuFlyoutItem x:Name="DeleteMenuFlyoutItem" Click="Delete_FlyoutItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

            </MenuFlyout>
        </Grid.ContextFlyout>

        <StackPanel Margin="8">

            <Grid Background="{ThemeResource SystemFillColorNeutralBrush}" Height="4" Margin="12,0,12,0" Padding="0,4,0,0" CornerRadius="8" BorderBrush="{ThemeResource TextControlElevationBorderBrush}" BorderThickness="0.4" Opacity="0.2"/>
            <Grid Background="{ThemeResource SystemFillColorNeutralBrush}" Height="4" Margin="8,0,8,0" Padding="0,4,0,0" CornerRadius="8" BorderBrush="{ThemeResource TextControlElevationBorderBrush}" BorderThickness="0.4" Opacity="0.3"/>
            <Grid Height="150" Width="150" CornerRadius="8">
                <!--Imager Container Background-->
                <Rectangle Fill="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
                <!--Placeholder Icon-->
                <FontIcon Glyph="&#xEB9F;" FontSize="45" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <!--Actual Image-->
                <Image Source="{x:Bind ((vm:PlaylistViewModel)DataContext).Image, Mode=OneWay}" Stretch="Fill" />
                <!--Image Container Border-->
                <Border Background="Transparent" Opacity="0.2" BorderBrush="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="8"/>
            </Grid>

            <TextBlock Text="{x:Bind ((vm:PlaylistViewModel)DataContext).Title, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Margin="4,8,0,0" MaxLines="1" />

            <TextBlock Text="{x:Bind ((vm:PlaylistViewModel)DataContext).SubTitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="4,0,0,0" MaxLines="1" />

        </StackPanel>
    </Grid>
</UserControl>
